timeseries
  util = avg(purefa.array.space_utilization),
  space_bytes = avg(purefa.array.space_bytes),
  by:{`dt.entity.purestorage:fa-array`},
  from:-24h,
  interval:1m

| fieldsAdd
    total_bytes = arrayLast(space_bytes),
    last_util_pct = arrayLast(util)

| fieldsAdd
    total_TB = total_bytes / 1000000000000.0,
    used_TB = total_bytes * (last_util_pct / 100.0) / 1000000000000.0,
    free_TB = total_bytes * (1.0 - last_util_pct / 100.0) / 1000000000000.0

| fields
    entityName(`dt.entity.purestorage:fa-array`),
    total_TB,
    used_TB,
    free_TB,
    last_util_pct
