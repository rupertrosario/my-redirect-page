timeseries {
  avg_op_bytes    = avg(purefa_array_performance_average_bytes),
  bandwidth_bytes = avg(purefa_array_performance_bandwidth_bytes),
  latency_usec    = avg(purefa_array_performance_latency_usec),
  queue_depth_ops = avg(purefa_array_performance_queue_depth_ops),
  throughput_iops = avg(purefa_array_performance_throughput_iops),
  space_bytes     = avg(purefa_array_space_bytes),
  reduction_ratio = avg(purefa_array_space_data_reduction_ratio),
  utilization_pct = avg(purefa_array_space_utilization)
}, by:{`dt.entity.purestorage:fa-array`}, from:-24h, interval:10m

| fields
    array_name = entityName(`dt.entity.purestorage:fa-array`),
    average_operation_KB = arrayLast(avg_op_bytes) / 1000.0,
    bandwidth_MB_per_sec = arrayLast(bandwidth_bytes) / 1000000.0,
    latency_usec = arrayLast(latency_usec),
    queue_depth_ops = arrayLast(queue_depth_ops),
    throughput_IOPS = arrayLast(throughput_iops),
    space_TB = arrayLast(space_bytes) / 1000000000000.0,
    data_reduction_ratio = arrayLast(reduction_ratio),
    utilization_pct = arrayLast(utilization_pct)
