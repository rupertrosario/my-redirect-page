timeseries {
  space = avg(purefa_array_space_bytes),
  utilization = avg(purefa_array_space_utilization),
  reduction = avg(purefa_array_space_data_reduction_ratio)
}, by:{`dt.entity.purestorage:fa-array`}, from:-1h
| fields
    array = entityName(`dt.entity.purestorage:fa-array`),
    space_tb = arrayLast(space) / 1000000000000.0,
    utilization_pct = arrayLast(utilization),
    data_reduction = arrayLast(reduction)
