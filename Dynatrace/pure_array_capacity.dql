timeseries {
  space_bytes = avg(purefa_array_space_bytes),
  utilization = avg(purefa_array_space_utilization),
  data_reduction = avg(purefa_array_space_data_reduction_ratio)
},
by:{`dt.entity.purestorage:fa-array`},
from:-24h,
interval:10m

| fieldsAdd
    latest_space_bytes = arrayLast(space_bytes),
    latest_utilization = arrayLast(utilization),
    latest_data_reduction = arrayLast(data_reduction)

| fields
    array_name = entityName(`dt.entity.purestorage:fa-array`),
    space_TB = latest_space_bytes / 1000000000000.0,
    utilization_pct = latest_utilization,
    data_reduction_ratio = latest_data_reduction
