// Pure Storage array capacity — minimal latest 10-minute view
// Assumption: purefa.array.space_bytes reports used bytes
// and purefa.array.space_utilization reports a percentage from 0 to 100.

timeseries {
  used_bytes = avg(purefa.array.space_bytes),
  used_pct   = avg(purefa.array.space_utilization)
}, by:{`dt.entity.purestorage:fa-array`}, from:-10m, interval:10m
| fieldsAdd array_name = entityName(`dt.entity.purestorage:fa-array`)
| fieldsAdd used_TB = arrayLast(used_bytes) / 1000000000000.0,
            utilization_pct = arrayLast(used_pct)
| fieldsAdd total_TB = used_TB / (utilization_pct / 100.0)
| fieldsAdd free_TB = total_TB - used_TB
| fields array_name, total_TB, used_TB, free_TB, utilization_pct
