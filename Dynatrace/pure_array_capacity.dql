// Pure Storage array capacity — minimal latest 10-minute view
// No derived field is referenced by another derived field.

timeseries {
  used_bytes = avg(purefa.array.space_bytes),
  used_pct   = avg(purefa.array.space_utilization)
}, by:{`dt.entity.purestorage:fa-array`}, from:-10m, interval:10m
| fields
    array_name = entityName(`dt.entity.purestorage:fa-array`),
    used_tb = arrayLast(used_bytes) / 1000000000000.0,
    total_tb = (arrayLast(used_bytes) / 1000000000000.0) / (arrayLast(used_pct) / 100.0),
    free_tb = ((arrayLast(used_bytes) / 1000000000000.0) / (arrayLast(used_pct) / 100.0)) - (arrayLast(used_bytes) / 1000000000000.0),
    utilization_pct = arrayLast(used_pct)
