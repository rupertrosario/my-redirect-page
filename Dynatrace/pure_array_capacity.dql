// Pure Storage array capacity validation and derived capacity
// Assumption: purefa.array.space_bytes reports used bytes.
// Validate latest_util first: expected scale is 0-100 (for example, 72.5).

timeseries {
  space_bytes = avg(purefa.array.space_bytes),
  util_pct    = avg(purefa.array.space_utilization)
}, by:{`dt.entity.purestorage:fa-array`}, from:-1h, interval:1m
| fieldsAdd array = entityName(`dt.entity.purestorage:fa-array`)
| fieldsAdd latest_space_bytes = arrayLast(space_bytes),
            latest_util_pct    = arrayLast(util_pct)
| fieldsAdd used_TB  = latest_space_bytes / 1000000000000.0,
            total_TB = used_TB / (latest_util_pct / 100.0)
| fieldsAdd free_TB = total_TB - used_TB
| fields array,
         used_TB,
         total_TB,
         free_TB,
         latest_util_pct,
         latest_space_bytes
