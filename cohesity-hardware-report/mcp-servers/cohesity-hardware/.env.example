# Copy this file to `.env` in this same folder and fill in YOUR OWN values.
# Never commit the real `.env` — it's covered by the repo's .gitignore.
# Each person/agent running this server needs their own credentials; nothing
# here is shared or bundled.

# Base URL of your Cohesity cluster or the Helios gateway.
# NO trailing "/v2", NO trailing slash.
# Examples:
#   https://helios.cohesity.com
#   https://mycluster.example.com
COHESITY_BASE_URL=

# API key value sent in the `apiKey` header.
# Generate one in: Cluster UI -> Settings -> Access Management -> API Keys
# (or in Helios: Settings -> API Keys).
COHESITY_API_KEY=

# Only required when COHESITY_BASE_URL is https://helios.cohesity.com and you
# need to target one specific registered cluster through the Helios gateway.
COHESITY_ACCESS_CLUSTER_ID=

# Set to false ONLY if your cluster uses a self-signed certificate you
# already trust. Leave true otherwise.
COHESITY_VERIFY_SSL=true

# --- Optional resilience tuning (defaults shown; safe to leave unset) -----
COHESITY_TIMEOUT_SECS=30
COHESITY_MAX_RETRIES=3
COHESITY_BACKOFF_FACTOR=1.0
